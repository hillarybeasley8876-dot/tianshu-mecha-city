class_name FlowGameFlow
extends Node
## The demo from title to victory (brief §1, SPEC §8): title → drop-in → tutorial → district →
## boss gate → boss → victory, with death putting the player back at the last checkpoint at full
## HP/EN. `main.tscn` instances `flow/game_flow.tscn` last, so everything it talks to exists by the
## time `_start()` runs; every hook into another unit is optional and duck-typed, because any of them
## can be stubbed out (`--stub=…`) and the demo still has to run.
##
## Objectives, checkpoints, the spires and the respawn itself live in `FlowProgress`; this file is
## only the states and the transitions between them.

signal state_changed(from: StringName, to: StringName)
signal spire_destroyed(id: StringName, count: int)

enum S { TITLE, DROP_IN, TUTORIAL, DISTRICT, BOSS_GATE, BOSS, VICTORY, GAME_OVER }

const NAMES: Array[StringName] = [&"title", &"drop_in", &"tutorial", &"district", &"boss_gate",
		&"boss", &"victory", &"game_over"]
const VISTA_TIME := 4.5
## `HudMenuRoot.Page` values, read numerically so the flow never depends on the hud class (any part of
## the hud can be stubbed out and the demo still has to run). hud r6 adds `abort_to_title`, and the
## `quit_game` fallback below goes away with it.
const TITLE_PAGE := 1
const PAUSE_PAGE := 2
## s before the out-of-bounds check can fire again, so a checkpoint that is itself out of the world
## (never in the city, but a stubbed test world can do anything) cannot loop.
const BOUNDS_COOLDOWN := 2.0
## m out from a fallen hive its checkpoint stands, how long a clear walk-forward lane has to be, and
## how many bearings are tried before the search gives up and takes the first floor it found.
const SPIRE_STANDOFF := 38.0
const LANE := 45.0
const LANE_BEARINGS := 8
## SPEC §8 music curve; the encounter director raises it while a fight is on (brief §2).
const MUSIC: Dictionary = {
	S.TITLE: 0.0, S.DROP_IN: 0.3, S.TUTORIAL: 0.4, S.DISTRICT: 0.2, S.BOSS_GATE: 0.5,
	S.BOSS: 1.0, S.VICTORY: 0.0, S.GAME_OVER: 0.0,
}
## The objective each state shows; the district line is generated by FlowProgress (it counts).
const OBJECTIVES: Dictionary = {
	S.TUTORIAL: "清除集装箱场的蚀骸  CLEAR THE CONTAINER YARD",
	S.BOSS_GATE: "登上天枢之冠  ASCEND TO THE CROWN",
	S.BOSS: "击杀巢母  KILL THE BROOD TITAN",
}

var state: int = S.TITLE
## Test seam: when false the flow never arms its own encounter director (the test harness drives its
## own copy, and the sandbox captures of other units do not want waves).
var auto_waves: bool = true
var director: FlowEncounterDirector = null
var tutorial: FlowTutorialDirector = null
var victory: FlowVictoryDirector = null
var progress: FlowProgress = null
## The Crown: the gate, the catapult and the boss arena that belongs to the fight (see `crown_gate.gd`).
var crown: FlowCrownGate = null

var _drop: FlowDropIn = null
var _combat: float = 0.0
var _frame_off: Dictionary = {}   ## node -> [physics_processing, processing] while `set_frame_work` holds
## Test seam (r5 brief item 9): milliseconds of deliberate busy-loop added to flow's own physics tick.
## `test_flow_perf.gd` sets it to prove its gate can FAIL — a measurement that always reads 0.000 ms
## is not a gate. 0 in every other run.
var perf_busy_ms: float = 0.0
var _title_lights: Array[OmniLight3D] = []
var _warned_boss: bool = false
## The menus page that was up when the game was paused, or -1. Only `Events.paused_changed` writes it
## (see `_on_quit_pressed`).
var _paused_page: int = -1
var _bounds_cool: float = 0.0


func _ready() -> void:
	director = _child(FlowEncounterDirector.new(), "Encounters") as FlowEncounterDirector
	tutorial = _child(FlowTutorialDirector.new(), "Tutorial") as FlowTutorialDirector
	victory = _child(FlowVictoryDirector.new(), "Victory") as FlowVictoryDirector
	_drop = _child(FlowDropIn.new(), "DropIn") as FlowDropIn
	progress = _child(FlowProgress.new(), "Progress") as FlowProgress
	crown = _child(FlowCrownGate.new(), "Crown") as FlowCrownGate
	crown.reached_crown.connect(_enter_boss)
	progress.director = director
	_child(FlowDebug.new(), "Debug").call(&"setup", self)
	tutorial.hint_changed.connect(progress.set_hint)
	director.intensity_changed.connect(_on_combat_intensity)
	director.arena_cleared.connect(_on_arena_cleared)
	progress.objective_changed.connect(func(text: String) -> void:
		Events.objective_changed.emit(text))
	progress.spire_destroyed.connect(_on_spire_destroyed)
	progress.all_spires_down.connect(_on_all_spires_down)
	progress.respawned.connect(_on_respawned)
	Events.player_died.connect(_on_player_died)
	Events.game_won.connect(_on_game_won)
	Events.boss_phase.connect(_on_boss_phase)
	Events.paused_changed.connect(_on_paused_changed)
	_start.call_deferred()


func _child(node: Node, node_name: String) -> Node:
	node.name = node_name
	add_child(node)
	return node


# --- boot -----------------------------------------------------------------------------------------

func _start() -> void:
	if not should_run():
		return
	if Game.world == null and Game.stubbed("world"):
		push_warning("FlowGameFlow: no world — the flow stays idle")
		return
	var spire_arenas := progress.build_spires()
	# No waves until the hero is on the ground: a roaming pack spawned during the title or the 400 m
	# fall arrives where the player cannot see it and eats the enemy budget (audit #3).
	director.enabled = false
	if Game.has_flag("sandbox"):
		director.build_sandbox(FlowWorld.player_start().origin, 220.0)
	else:
		director.build(spire_arenas)
	crown.build()
	_connect_menus()
	if Game.has_flag("skip-menu") or Game.has_flag("sandbox"):
		_begin_drop_in()
	else:
		_title()


## CONTRACTS §2 (flags): `--sandbox` is FREE PLAY for every other unit's tests — the flow stays idle
## there (no drop-in, tutorial, spires, waves or prompts; the hero stands on the sandbox `PlayerSpawn`)
## unless `--flow` asks for it. Without `--sandbox` the full demo runs and `--skip-menu` only skips the
## title. This is a print, not a warning: another unit's clean capture run must not collect our noise.
static func should_run() -> bool:
	if not Game.has_flag("sandbox") or Game.has_flag("flow"):
		return true
	print("FLOW idle: --sandbox without --flow (free play)")
	return false


func _connect_menus() -> void:
	var menus := _menus()
	if menus == null:
		return
	_connect(menus, &"start_game", _on_start_pressed)
	_connect(menus, &"retry_game", _on_retry_pressed)
	_connect(menus, &"abort_to_title", abort_to_title)
	_connect(menus, &"quit_game", _on_quit_pressed)


## Tool and test seam (lead r3): stop every per-frame body flow owns so a profile can measure what the
## flow costs the frame, and hand it back exactly as it was (several children idle themselves on
## purpose — the drop-in before it starts, the visual of a destroyed spire).
func set_frame_work(on: bool) -> void:
	if on:
		for node: Node in _frame_off:
			node.set_physics_process(bool(_frame_off[node][0]))
			node.set_process(bool(_frame_off[node][1]))
		_frame_off.clear()
		return
	for child in get_children():
		_hold_branch(child)


func _hold_branch(node: Node) -> void:
	if not _frame_off.has(node):
		_frame_off[node] = [node.is_physics_processing(), node.is_processing()]
	node.set_physics_process(false)
	node.set_process(false)
	for child in node.get_children():
		_hold_branch(child)


func _menus() -> Node:
	return Game.hud.get(&"menus") as Node if Game.hud != null else null


func _connect(source: Node, signal_name: StringName, target: Callable) -> void:
	if source.has_signal(signal_name) and not source.is_connected(signal_name, target):
		source.connect(signal_name, target)


# --- states ---------------------------------------------------------------------------------------

func _go(next: int) -> void:
	if next == state:
		return
	var from := NAMES[state]
	state = next
	Audio.music_intensity(maxf(float(MUSIC[next]), _combat))
	progress.refresh_objective(NAMES[next], String(OBJECTIVES.get(next, "")))
	state_changed.emit(from, NAMES[next])


func state_name() -> StringName:
	return NAMES[state]


## SPEC §8.1: "Title (hero on a lit hangar platform, skyline behind)". The old shot put the lens 110 m
## out and 30 m up at 62° with the mech parked at the landing in the dark, so the frame was a dim
## container yard with a speck behind the logo (r5 brief item 9). This one stands 45 m off the pad at
## chest height, aims just past the mech's shoulder so the logo does not sit on it, and looks along
## world −Z — which from the Insertion Pier is straight at the Spire and the skyline.
const TITLE_SHOT: Dictionary = {
	"offset": Vector3(28.0, 9.0, 34.0), "look": Vector3(-7.0, 12.0, 2.0), "fov": 42.0, "t": 0.0,
}
## The platform light: unshadowed (the engine rules ban a shadowed omni on a moving rig, and this one
## never moves), warm, and gone the moment the drop-in starts.
## Two of them: a warm key on the camera side so the mech is lit rather than a silhouette, and a cool
## rim from behind so its edges separate from the dusk. Both unshadowed, both gone when the drop starts.
const TITLE_LIGHTS: Array[Dictionary] = [
	{"offset": Vector3(13.0, 13.0, 11.0), "colour": Color(1.0, 0.86, 0.66), "energy": 26.0,
		"range": 55.0},
	{"offset": Vector3(-16.0, 17.0, -13.0), "colour": Color(0.58, 0.80, 1.0), "energy": 16.0,
		"range": 60.0},
]


func _title() -> void:
	_go(S.TITLE)
	Audio.voice(&"ai_boot", 90.0, 2.0)
	_light_the_platform()
	_cinematic([TITLE_SHOT], 100000.0)


## A key light over the landing pad, so the mech reads as a lit hero instead of a silhouette. It is
## parented to the flow, not to the world, so a checkpoint respawn or an abort never leaves a lamp
## burning over an empty pad.
func _light_the_platform() -> void:
	if not _title_lights.is_empty():
		return
	var at := FlowWorld.player_start().origin
	for row: Dictionary in TITLE_LIGHTS:
		var lamp := OmniLight3D.new()
		lamp.name = "TitleLight%d" % _title_lights.size()
		lamp.light_color = row["colour"]
		lamp.light_energy = float(row["energy"])
		lamp.omni_range = float(row["range"])
		lamp.shadow_enabled = false
		lamp.position = at + (row["offset"] as Vector3)
		add_child(lamp)
		_title_lights.append(lamp)


func _unlight_the_platform() -> void:
	for lamp: OmniLight3D in _title_lights:
		if is_instance_valid(lamp):
			lamp.queue_free()
	_title_lights.clear()


func _on_start_pressed() -> void:
	_begin_drop_in()


func _begin_drop_in() -> void:
	_unlight_the_platform()
	if Game.has_flag("spawn"):
		# A scripted run placed the hero itself: no drop, straight into the tutorial.
		_enter_tutorial()
		return
	_go(S.DROP_IN)
	if not _drop.finished.is_connected(_on_landed):
		_drop.finished.connect(_on_landed, CONNECT_ONE_SHOT)
	_drop.begin(FlowWorld.player_start())


func _on_landed(_at: Vector3, _hard: bool) -> void:
	Audio.voice(&"ai_systems_online", 80.0, 2.2)
	_enter_tutorial()


func _enter_tutorial() -> void:
	_go(S.TUTORIAL)
	# `--spawn` comes straight here from the title, whose vista shot is held for 100000 s: without this
	# the rig would keep the camera for the rest of the run (audit #2).
	_end_cinematic()
	if auto_waves:
		director.enabled = true
	# SPEC §7.1's first checkpoint, written the moment the tutorial starts: the yard is a real fight
	# (two ripper waves and a mantis) and a death in it used to have nothing to respawn at, which
	# soft-locked the whole run (r5 brief item 1). `_enter_district` overwrites it with the district
	# state as soon as the yard is clear.
	progress.save(&"start", NAMES[S.TUTORIAL], 0)
	tutorial.begin()
	Audio.voice(&"ai_objective_new", 70.0, 2.0)


func _on_arena_cleared(_id: StringName) -> void:
	if state != S.TUTORIAL:
		return
	tutorial.finish()
	Audio.voice(&"ai_district_clear", 70.0, 2.0)
	_enter_district()


func _enter_district() -> void:
	_go(S.DISTRICT)
	# The three spires can fall before the tutorial yard is cleared (a scripted run, a speedrunner who
	# ignores A1): `all_spires_down` was emitted while the flow was still in the tutorial and ignored,
	# so the district has to notice for itself or the run sits at 3/3 for ever.
	if progress.spires_down().size() >= FlowProgress.SPIRE_TOTAL:
		_enter_boss_gate()
		return
	# A spire that fell during the tutorial already wrote a better checkpoint than the start one.
	if progress.spires_down().is_empty():
		progress.save(&"start", NAMES[S.DISTRICT], 0)


## A standing point `SPIRE_STANDOFF` metres out from `at` on the side `from` is on, dropped onto the
## first floor under it, with `LANE` metres of clear ground ahead. Eight bearings are tried, starting
## with the one the hero is already on; the first floor found is the fallback, so a hive in a pocket
## still gets a checkpoint.
func stand_off(at: Vector3, from: Vector3) -> Vector3:
	var tree := get_tree()
	var out := Vector3(from.x - at.x, 0.0, from.z - at.z)
	out = out.normalized() if out.length() > 1.0 else Vector3.FORWARD
	var fallback := Vector3.INF
	for i in LANE_BEARINGS:
		var bearing := out.rotated(Vector3.UP, TAU * float(i) / float(LANE_BEARINGS))
		var want := at + bearing * SPIRE_STANDOFF
		var floor_at := _floor_under(tree, want)
		if floor_at == Vector3.INF:
			continue
		if fallback == Vector3.INF:
			fallback = floor_at
		if _lane_is_clear(tree, floor_at, bearing):
			return floor_at
	return fallback if fallback != Vector3.INF else at + out * SPIRE_STANDOFF


## The first WORLD surface under a point, or INF when there is none within reach.
func _floor_under(tree: SceneTree, at: Vector3) -> Vector3:
	var space := _space(tree)
	if space == null:
		return Vector3.INF
	var from := at + Vector3.UP * 60.0
	var query := PhysicsRayQueryParameters3D.create(from, from - Vector3.UP * 200.0, Layers.WORLD)
	var hit := space.intersect_ray(query)
	return Vector3.INF if hit.is_empty() else (hit["position"] as Vector3).y * Vector3.UP + at * Vector3(1.0, 0.0, 1.0)


## `LANE` metres of nothing but air ahead at chest height, so walk-forward leaves the checkpoint.
func _lane_is_clear(tree: SceneTree, at: Vector3, bearing: Vector3) -> bool:
	var space := _space(tree)
	if space == null:
		return false
	var from := at + Vector3.UP * 8.0
	var query := PhysicsRayQueryParameters3D.create(from, from + bearing * LANE, Layers.WORLD)
	return space.intersect_ray(query).is_empty()


func _space(tree: SceneTree) -> PhysicsDirectSpaceState3D:
	var root := tree.root as Viewport
	if root == null:
		return null
	var world := root.find_world_3d()
	return null if world == null else world.direct_space_state


func _spire_by_id(id: StringName) -> FlowHiveSpire:
	for spire in progress.spires():
		if spire.spire_id == id:
			return spire
	return null


## Every fallen spire is a checkpoint (SPEC §7.1) and moves the district counter.
func _on_spire_destroyed(id: StringName, count: int) -> void:
	spire_destroyed.emit(id, count)
	# A spire checkpoint is a PROBED point with a walk-forward lane, not the hero's live transform
	# (lead, r5): the hero is standing against the trunk it just destroyed when the hive falls, so the
	# old save put the respawn nose-to-bark — W for 1.5 s moved 0.3 m with the HUD reading
	# "BLOCKED 4m". `stand_off` puts it `SPIRE_STANDOFF` metres out on the side the hero was already
	# on, dropped onto the floor and facing further out.
	var spire := _spire_by_id(id)
	var at := spire.global_position if spire != null else Vector3.ZERO
	var from := Game.player.global_position if Game.player != null else at
	var spot := stand_off(at, from)
	progress.save_at(StringName("spire_" + String(id)), NAMES[S.DISTRICT], 0, spot,
			spot + (spot - at).normalized() * LANE)
	progress.refresh_objective(NAMES[state], String(OBJECTIVES.get(state, "")))


func _on_all_spires_down() -> void:
	if state == S.DISTRICT:
		_enter_boss_gate()


func _enter_boss_gate(look: bool = true) -> void:
	_go(S.BOSS_GATE)
	Audio.voice(&"ai_titan_approach", 85.0, 2.6)
	crown.open()
	progress.set_hint(FlowAscensionCatapult.HINT)
	if not look:
		return
	# One look at the crown before the player commits to the catapult (dossier §4.5).
	_cinematic([{"offset": Vector3(0.0, 120.0, 300.0), "look": Vector3(0.0, 260.0, -600.0),
			"fov": 70.0, "t": 0.0}], VISTA_TIME)


func _enter_boss() -> void:
	_go(S.BOSS)
	# The pad hint is a boss-GATE line: leaving it up tells the player to step on a catapult in the
	# middle of the fight (r5 brief item 2).
	progress.set_hint("")
	_boss_checkpoint(1)
	if get_tree().get_nodes_in_group(&"boss").is_empty() and not _warned_boss:
		_warned_boss = true
		push_warning("FlowGameFlow: no boss in the tree — the boss unit has not landed yet")


## SPEC §7.1: every boss phase is a checkpoint, and all three save the SAME probed point on the
## fighting floor — never the live transform, which at a phase change can be mid-air on the catapult
## arc or wedged between two deck rings (r5 brief item 2).
func _boss_checkpoint(phase: int) -> void:
	var tree := get_tree()
	progress.save_at(StringName("boss_p%d" % phase), NAMES[S.BOSS], phase,
			FlowCrownDeck.fight_point(tree), FlowCrownDeck.centre(tree))


func _on_game_won() -> void:
	if state == S.VICTORY:
		return
	var from := NAMES[state]
	state = S.VICTORY
	victory.begin(progress.run_time())
	state_changed.emit(from, NAMES[S.VICTORY])


func _on_player_died() -> void:
	if state == S.VICTORY or state == S.GAME_OVER:
		return
	_go(S.GAME_OVER)
	Audio.music_intensity(0.0)
	Audio.stinger(&"stinger_defeat")
	Audio.voice(&"ai_failure", 90.0, 2.0)


func _on_retry_pressed() -> void:
	respawn()


## hud r6 splits PAUSE → ABORT into its own `abort_to_title` signal and leaves `quit_game` to quit the
## app (lead r16 decision 3). Until that signal ships, flow answers `quit_game` itself, and only while
## the PAUSE page is the one up — ABORT is the only `quit_game` the hud emits with the tree paused, and
## the page number keeps a paused GAME_OVER (hud r6) from being read as a pause.
func _on_quit_pressed() -> void:
	# The page is read at the moment the game was PAUSED, not at the moment `quit_game` arrives: a
	# `quit_game` can reach flow while the tree is paused for something else entirely, and the r5
	# matrix run had one abort the whole mission that way. `_paused_page` is only ever set by
	# `Events.paused_changed`, which the menus emit with the page they are showing.
	print("FLOW quit_game: paused_page=%d paused=%s state=%s" % [_paused_page,
			str(get_tree().paused), NAMES[state]])
	if _paused_page != PAUSE_PAGE or not get_tree().paused:
		return
	abort_to_title()


func _on_paused_changed(paused: bool) -> void:
	var menus := _menus()
	_paused_page = int(menus.get(&"page")) if paused and menus != null else -1


## ABORT: the mission is over and the demo goes back to the title with nothing carried over, unpaused
## (r5 brief item 5). START from there is a fresh run — 0/3 spires, no checkpoint.
func abort_to_title() -> void:
	var menus := _menus()
	if menus != null and menus.has_method(&"close"):
		menus.call(&"close")
	get_tree().paused = false
	_end_cinematic()
	director.enabled = false
	progress.reset_run()
	for node in get_tree().get_nodes_in_group(&"boss_director"):
		if node.has_method(&"abort_fight"):
			node.call(&"abort_fight")
	tutorial.finish()
	_title()
	if menus != null and menus.has_method(&"show_page"):
		menus.call(&"show_page", TITLE_PAGE)
	print("FLOW aborted to the title")


func _on_boss_phase(phase: int) -> void:
	if state == S.BOSS:
		_boss_checkpoint(phase)


func _on_combat_intensity(level: float) -> void:
	_combat = level
	Audio.music_intensity(maxf(float(MUSIC[state]), _combat))


func _cinematic(shots: Array, seconds: float) -> void:
	var rig := Game.camera_rig
	if rig != null and rig.has_method(&"request_cinematic"):
		rig.call(&"request_cinematic", shots, seconds)


## Hand the view back after a cinematic flow started itself (CONTRACTS §5).
func _end_cinematic() -> void:
	var rig := Game.camera_rig
	if rig != null and rig.has_method(&"end_cinematic"):
		rig.call(&"end_cinematic")


# --- checkpoints and respawn ----------------------------------------------------------------------

func respawn() -> void:
	var menus := _menus()
	if menus != null and menus.has_method(&"close"):
		menus.call(&"close")
	# The landing is the answer to a death before any checkpoint exists; `progress.respawn` pushes an
	# error when it has to use it, so the fallback is never silent (r5 brief item 1).
	progress.respawn(_landing_transform(), NAMES[S.TUTORIAL])


## Where the hero started the run: the drop-in landing marker, with the facing the world gave it.
func _landing_transform() -> Transform3D:
	return FlowWorld.player_start()


## FlowProgress restored the world; the state machine follows it back to the checkpoint's state.
func _on_respawned(resume_state: StringName) -> void:
	# The last spire may have fallen after the checkpoint: the district is done and the catapult is
	# open, so resuming "district" would leave the objective reading 3/3 DESTROY.
	if resume_state == &"district" and progress.spires_down().size() >= FlowProgress.SPIRE_TOTAL:
		_enter_boss_gate(false)
		return
	var previous := NAMES[state]
	# A "tutorial" checkpoint resumes the tutorial: the yard re-arms (FlowProgress resets every arena
	# that was not done) and clearing it opens the district again. It must not be lifted to DISTRICT,
	# or `_on_arena_cleared` would ignore the clear for ever (r5 brief item 1).
	state = maxi(NAMES.find(resume_state), S.TUTORIAL)
	if state == S.TUTORIAL:
		director.enabled = auto_waves
		tutorial.resume()
	if state == S.BOSS and progress.hint() != "":
		# The catapult hint belongs to the boss GATE; a boss-phase RETRY must not bring it back
		# (r5 brief item 2).
		progress.set_hint("")
	Audio.music_intensity(float(MUSIC[state]))
	progress.refresh_objective(NAMES[state], String(OBJECTIVES.get(state, "")))
	state_changed.emit(previous, NAMES[state])


# --- accessors used by tools, tests and flow_debug -------------------------------------------------

func spires() -> Array[FlowHiveSpire]:
	return progress.spires()


func spires_down() -> Array[StringName]:
	return progress.spires_down()


func checkpoint() -> FlowCheckpoint:
	return progress.checkpoint()


func run_time() -> float:
	return progress.run_time()


func _physics_process(delta: float) -> void:
	if perf_busy_ms > 0.0:
		var until := Time.get_ticks_usec() + int(perf_busy_ms * 1000.0)
		while Time.get_ticks_usec() < until:
			pass
	if state == S.BOSS_GATE:
		crown.tick()
	if state != S.TITLE and state != S.GAME_OVER:
		# The victory page shows how long the run took: that is unscaled time, so hit-stops, slow-mos
		# and witch time do not shorten the player's run (audit #4, CONTRACTS §3).
		progress.tick(Feel.real_delta(delta))
	_check_bounds()


## r5 brief item 5: a mech that has left the world gets the RETRY respawn, not a 3,000 m fall with
## nothing listening. The title and the scripted drop-in own the hero's height themselves, and the
## Crown's own catch runs during the fight (`boss_arena.gd`), so none of those are ours to second-guess.
func _check_bounds() -> void:
	_bounds_cool = maxf(_bounds_cool - get_physics_process_delta_time(), 0.0)
	if _bounds_cool > 0.0 or state == S.TITLE or state == S.DROP_IN or state == S.BOSS \
			or state == S.VICTORY:
		return
	var why := FlowBounds.reason(Game.player)
	if why == "":
		return
	_bounds_cool = BOUNDS_COOLDOWN
	print("FLOW out of the world: %s — respawning at the last checkpoint" % why)
	respawn()
